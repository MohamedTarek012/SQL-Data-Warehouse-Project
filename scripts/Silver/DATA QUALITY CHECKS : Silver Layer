-- ============================================================================================================================
-- DATA QUALITY CHECKS : Silver Layer
-- ============================================================================================================================
-- Purpose   : Validate every Silver table after a load run.
--             Each check prints a label and returns a result set so you can instantly see
--             whether a rule passes (0 = no violations) or fails (N = rows to investigate).
-- How to use: Run this script in full after calling  EXEC silver.load_silver
--             Any result set with count > 0 requires investigation before promoting to Gold.
-- Structure : One section per Silver table, checks grouped by category:
--               [NULLs]       – mandatory fields must not be null
--               [Duplicates]  – unique/PK columns must not repeat
--               [Format]      – values must match expected domain / range
--               [Referential] – join keys must resolve across tables
--               [Dates]       – temporal integrity rules
-- ============================================================================================================================


-- ============================================================
--  TABLE 1 :  silver.crm_prd_info
-- ============================================================

PRINT '============================================================';
PRINT ' Quality checks  →  silver.crm_prd_info';
PRINT '============================================================';

-- [NULLs] prd_id, prd_key, prd_sub_key, prd_nm must never be NULL
-- Expected: 0   |  A NULL here means the Bronze load is broken or source file is corrupt
PRINT '>> [NULL]  prd_id / prd_key / prd_sub_key / prd_nm';
SELECT
    COUNT(*) AS null_violations
FROM silver.crm_prd_info
WHERE prd_id      IS NULL
   OR prd_key     IS NULL
   OR prd_sub_key IS NULL
   OR prd_nm      IS NULL;

-- [Duplicates] prd_id is the natural primary key – no two rows should share it
-- Expected: 0   |  Duplicates would cause fan-out in downstream joins
PRINT '>> [DUPLICATE]  prd_id';
SELECT
    prd_id,
    COUNT(*) AS duplicate_count
FROM silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1;

-- [Format] prd_cost must be >= 0 after NULL replacement
-- Expected: 0   |  Negative cost is logically invalid for a product catalogue
PRINT '>> [FORMAT]  prd_cost  (must be >= 0)';
SELECT
    COUNT(*) AS negative_cost_rows
FROM silver.crm_prd_info
WHERE prd_cost < 0;

-- [Format] prd_line should only contain recognised labels (including N/A for unknowns)
-- Expected: 0   |  Any value outside this set means a new source code was added and the CASE is incomplete
PRINT '>> [FORMAT]  prd_line  (must be in known set)';
SELECT
    prd_line,
    COUNT(*) AS cnt
FROM silver.crm_prd_info
WHERE prd_line NOT IN ('Road', 'Mountain', 'Other Sale', 'Touring', 'N/A')
GROUP BY prd_line;

-- [Dates] prd_end_dt must be NULL (active) or strictly AFTER prd_start_dt
-- Expected: 0   |  This is the core fix applied during the load (LEAD derivation)
--               |  Any violation here means the LEAD logic failed or start_dt parse broke
PRINT '>> [DATE]  prd_end_dt must be NULL or > prd_start_dt';
SELECT
    COUNT(*) AS invalid_date_range_rows
FROM silver.crm_prd_info
WHERE prd_end_dt IS NOT NULL
  AND prd_end_dt <= prd_start_dt;

-- [Referential] cat_id must exist in erp_px_cat_g1v2 or be NULL (for rare products with no category)
-- Expected: 0   |  Orphaned cat_id means products cannot be categorised in the Gold layer
PRINT '>> [REFERENTIAL]  cat_id  →  erp_px_cat_g1v2.id';
SELECT
    p.cat_id,
    COUNT(*) AS orphaned_rows
FROM silver.crm_prd_info p
LEFT JOIN silver.erp_px_cat_g1v2 c ON p.cat_id = c.id
WHERE c.id IS NULL
  AND p.cat_id IS NOT NULL
GROUP BY p.cat_id;

-- [Referential] prd_sub_key must exist in crm_sales_details (or be a product never sold – also acceptable)
-- Expected: informational   |  Unmatched = product exists but has no sales (not necessarily an error)
PRINT '>> [INFO]  prd_sub_key with no matching sales records (unsold products)';
SELECT
    COUNT(*) AS products_never_sold
FROM silver.crm_prd_info p
LEFT JOIN silver.crm_sales_details s ON p.prd_sub_key = s.sls_prd_key
WHERE s.sls_prd_key IS NULL;

PRINT '';


-- ============================================================
--  TABLE 2 :  silver.crm_cust_info
-- ============================================================

PRINT '============================================================';
PRINT ' Quality checks  →  silver.crm_cust_info';
PRINT '============================================================';

-- [NULLs] cst_id and cst_key are the identity columns – must be populated
-- Expected: 0   |  NULL cst_id rows should have been filtered during load
PRINT '>> [NULL]  cst_id / cst_key';
SELECT
    COUNT(*) AS null_violations
FROM silver.crm_cust_info
WHERE cst_id  IS NULL
   OR cst_key IS NULL;

-- [Duplicates] cst_key is the business natural key – must be unique after deduplication
-- Expected: 0   |  Any duplicate here means the ROW_NUMBER dedup logic in the SP did not fire
PRINT '>> [DUPLICATE]  cst_key';
SELECT
    cst_key,
    COUNT(*) AS duplicate_count
FROM silver.crm_cust_info
GROUP BY cst_key
HAVING COUNT(*) > 1;

-- [Format] cst_marital_status must be one of three canonical values
-- Expected: 0   |  Any other value means a new code arrived in source that is not handled
PRINT '>> [FORMAT]  cst_marital_status  (Married | Single | N/A)';
SELECT
    cst_marital_status,
    COUNT(*) AS cnt
FROM silver.crm_cust_info
WHERE cst_marital_status NOT IN ('Married', 'Single', 'N/A')
GROUP BY cst_marital_status;

-- [Format] cst_gndr must be one of three canonical values
-- Expected: 0   |  Any other value means a new code arrived in source that is not handled
PRINT '>> [FORMAT]  cst_gndr  (Male | Female | N/A)';
SELECT
    cst_gndr,
    COUNT(*) AS cnt
FROM silver.crm_cust_info
WHERE cst_gndr NOT IN ('Male', 'Female', 'N/A')
GROUP BY cst_gndr;

-- [Format] No leading/trailing whitespace should remain in name fields
-- Expected: 0   |  LTRIM/RTRIM in the SP should have caught all of these
PRINT '>> [FORMAT]  cst_firstname / cst_lastname  (no surrounding whitespace)';
SELECT
    COUNT(*) AS whitespace_violations
FROM silver.crm_cust_info
WHERE cst_firstname != LTRIM(RTRIM(cst_firstname))
   OR cst_lastname  != LTRIM(RTRIM(cst_lastname));

PRINT '';


-- ============================================================
--  TABLE 3 :  silver.crm_sales_details
-- ============================================================

PRINT '============================================================';
PRINT ' Quality checks  →  silver.crm_sales_details';
PRINT '============================================================';

-- [NULLs] sls_ord_num, sls_prd_key, sls_cust_id are the order identity columns
-- Expected: 0   |  A NULL here means a transaction cannot be tracked or attributed
PRINT '>> [NULL]  sls_ord_num / sls_prd_key / sls_cust_id';
SELECT
    COUNT(*) AS null_violations
FROM silver.crm_sales_details
WHERE sls_ord_num  IS NULL
   OR sls_prd_key  IS NULL
   OR sls_cust_id  IS NULL;

-- [Format] sls_price and sls_sales must be positive after cleaning
-- Expected: 0   |  ABS() applied during load; any negative remaining is a logic gap
PRINT '>> [FORMAT]  sls_price / sls_sales  (must be > 0 where not NULL)';
SELECT
    COUNT(*) AS negative_value_rows
FROM silver.crm_sales_details
WHERE (sls_price < 0)
   OR (sls_sales < 0);

-- [Format] sls_sales should equal sls_quantity * sls_price (within 1 cent rounding tolerance)
-- Expected: 0   |  Any remaining mismatch means the recalculation logic in the SP is incomplete
PRINT '>> [FORMAT]  sls_sales must equal sls_quantity * sls_price  (tolerance ±0.01)';
SELECT
    COUNT(*) AS inconsistent_rows
FROM silver.crm_sales_details
WHERE ABS(sls_sales - sls_quantity * sls_price) > 0.01
  AND sls_sales    IS NOT NULL
  AND sls_price    IS NOT NULL
  AND sls_quantity IS NOT NULL;

-- [Dates] sls_order_dt must be <= sls_ship_dt and <= sls_due_dt (where both populated)
-- Expected: 0   |  Shipping/due before order date is logically impossible
PRINT '>> [DATE]  sls_order_dt must be <= sls_ship_dt and <= sls_due_dt';
SELECT
    COUNT(*) AS invalid_date_order_rows
FROM silver.crm_sales_details
WHERE (sls_order_dt > sls_ship_dt  AND sls_ship_dt IS NOT NULL)
   OR (sls_order_dt > sls_due_dt   AND sls_due_dt  IS NOT NULL);

-- [Referential] sls_prd_key must exist in crm_prd_info.prd_sub_key
-- Expected: 0   |  Orphaned sales rows cannot be enriched with product info in the Gold layer
PRINT '>> [REFERENTIAL]  sls_prd_key  →  crm_prd_info.prd_sub_key';
SELECT
    COUNT(*) AS orphaned_sales_rows
FROM silver.crm_sales_details s
LEFT JOIN silver.crm_prd_info p ON s.sls_prd_key = p.prd_sub_key
WHERE p.prd_sub_key IS NULL;

-- [Referential] sls_cust_id must exist in crm_cust_info.cst_id
-- Expected: 0   |  Orphaned sales rows cannot be attributed to a customer in the Gold layer
PRINT '>> [REFERENTIAL]  sls_cust_id  →  crm_cust_info.cst_id';
SELECT
    COUNT(*) AS orphaned_cust_rows
FROM silver.crm_sales_details s
LEFT JOIN silver.crm_cust_info c ON s.sls_cust_id = c.cst_id
WHERE c.cst_id IS NULL;

PRINT '';


-- ============================================================
--  TABLE 4 :  silver.erp_px_cat_g1v2
-- ============================================================

PRINT '============================================================';
PRINT ' Quality checks  →  silver.erp_px_cat_g1v2';
PRINT '============================================================';

-- [NULLs] All four columns are mandatory for this reference table
-- Expected: 0   |  A NULL in any column means the source ERP file is missing data
PRINT '>> [NULL]  id / cat / subcat / maintenance';
SELECT
    COUNT(*) AS null_violations
FROM silver.erp_px_cat_g1v2
WHERE id          IS NULL
   OR cat         IS NULL
   OR subcat      IS NULL
   OR maintenance IS NULL;

-- [Duplicates] id is the primary key of this reference table
-- Expected: 0   |  Duplicate category IDs would make the product join non-deterministic
PRINT '>> [DUPLICATE]  id';
SELECT
    id,
    COUNT(*) AS duplicate_count
FROM silver.erp_px_cat_g1v2
GROUP BY id
HAVING COUNT(*) > 1;

-- [Format] maintenance must be 0 or 1 only (BIT column)
-- Expected: 0   |  SQL Server BIT constraints this, but worth confirming
PRINT '>> [FORMAT]  maintenance  (0 or 1 only)';
SELECT
    COUNT(*) AS invalid_flag_rows
FROM silver.erp_px_cat_g1v2
WHERE maintenance NOT IN (0, 1);

PRINT '';


-- ============================================================
--  TABLE 5 :  silver.erp_loc_a101
-- ============================================================

PRINT '============================================================';
PRINT ' Quality checks  →  silver.erp_loc_a101';
PRINT '============================================================';

-- [NULLs] Both columns must be populated after cleaning
-- Expected: 0   |  cntry NULL should have been replaced with 'Unknown' during load
PRINT '>> [NULL]  cid / cntry';
SELECT
    COUNT(*) AS null_violations
FROM silver.erp_loc_a101
WHERE cid   IS NULL
   OR cntry IS NULL;

-- [Duplicates] cid is the primary key (one location per customer)
-- Expected: 0   |  Duplicate CIDs would cause a fan-out when joining to customer table
PRINT '>> [DUPLICATE]  cid';
SELECT
    cid,
    COUNT(*) AS duplicate_count
FROM silver.erp_loc_a101
GROUP BY cid
HAVING COUNT(*) > 1;

-- [Format] No raw abbreviations should remain after country normalisation
-- Expected: 0   |  'US', 'USA', 'DE' must all have been expanded during load
PRINT '>> [FORMAT]  cntry  (no raw abbreviations: US, USA, DE)';
SELECT
    cntry,
    COUNT(*) AS cnt
FROM silver.erp_loc_a101
WHERE cntry IN ('US', 'USA', 'DE')
GROUP BY cntry;

-- [Referential] cid must exist in crm_cust_info.cst_key
-- Expected: small number acceptable   |  ERP may have slightly more/fewer customers than CRM
-- Expected: 0 rows with cst_key IS NULL means all ERP customers have a CRM counterpart
PRINT '>> [REFERENTIAL]  cid  →  crm_cust_info.cst_key';
SELECT
    COUNT(*) AS cid_without_crm_match
FROM silver.erp_loc_a101 l
LEFT JOIN silver.crm_cust_info c ON l.cid = c.cst_key
WHERE c.cst_key IS NULL;

PRINT '';


-- ============================================================
--  TABLE 6 :  silver.erp_cust_az12
-- ============================================================

PRINT '============================================================';
PRINT ' Quality checks  →  silver.erp_cust_az12';
PRINT '============================================================';

-- [NULLs] cid and gen must be populated after cleaning
-- Expected: 0   |  gen NULL should have been replaced with 'N/A' during load
PRINT '>> [NULL]  cid / gen';
SELECT
    COUNT(*) AS null_violations
FROM silver.erp_cust_az12
WHERE cid IS NULL
   OR gen IS NULL;

-- [Duplicates] cid is the primary key (one demographic record per customer)
-- Expected: 0   |  Duplicate CIDs would cause a fan-out when joining to customer table
PRINT '>> [DUPLICATE]  cid';
SELECT
    cid,
    COUNT(*) AS duplicate_count
FROM silver.erp_cust_az12
GROUP BY cid
HAVING COUNT(*) > 1;

-- [Format] gen must be one of three canonical values only
-- Expected: 0   |  Abbreviations (M, F) and blanks must have been standardised during load
PRINT '>> [FORMAT]  gen  (Male | Female | N/A  only)';
SELECT
    gen,
    COUNT(*) AS cnt
FROM silver.erp_cust_az12
WHERE gen NOT IN ('Male', 'Female', 'N/A')
GROUP BY gen;

-- [Dates] bdate must be a real past date  (cannot be in the future or unreasonably old)
-- Expected: 0 future dates   |  future birthdates were set to NULL during load
-- Expected: 0 rows before 1900-01-01  |  no valid customer was born before 1900
PRINT '>> [DATE]  bdate  (no future dates, no dates before 1900)';
SELECT
    COUNT(*) AS invalid_bdate_rows
FROM silver.erp_cust_az12
WHERE bdate > CAST(GETDATE() AS DATE)
   OR bdate < '1900-01-01';

-- [Referential] cid must exist in crm_cust_info.cst_key
-- Expected: small delta acceptable   |  same note as erp_loc_a101
PRINT '>> [REFERENTIAL]  cid  →  crm_cust_info.cst_key';
SELECT
    COUNT(*) AS cid_without_crm_match
FROM silver.erp_cust_az12 a
LEFT JOIN silver.crm_cust_info c ON a.cid = c.cst_key
WHERE c.cst_key IS NULL;

-- [Consistency] Gender in erp_cust_az12 vs crm_cust_info – should agree where both are known
-- Expected: informational   |  mismatches do not block the pipeline but surface data conflicts
PRINT '>> [CONSISTENCY]  gen (ERP) vs cst_gndr (CRM)  –  mismatches where both sources are known';
SELECT
    COUNT(*) AS gender_conflict_rows
FROM silver.erp_cust_az12 a
JOIN silver.crm_cust_info c ON a.cid = c.cst_key
WHERE a.gen      <> 'N/A'
  AND c.cst_gndr <> 'N/A'
  AND a.gen      <> c.cst_gndr;

PRINT '';
PRINT '============================================================';
PRINT ' Silver Layer Quality Checks – COMPLETE';
PRINT ' Review any result set with count > 0 before loading Gold.';
PRINT '============================================================';
